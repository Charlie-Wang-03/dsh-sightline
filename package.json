{
  "name": "dsh-sightline",
  "version": "0.1.0",
  "description": "Compare DeepSeek Harness, Codex, and Claude Code instruction surfaces for the same workspace.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "claude-code",
    "ai-agent",
    "developer-tools",
    "agent-instructions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charlie-Wang-03/dsh-sightline.git"
  },
  "bugs": {
    "url": "https://github.com/Charlie-Wang-03/dsh-sightline/issues"
  },
  "homepage": "https://github.com/Charlie-Wang-03/dsh-sightline#readme",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/PACKAGING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:host": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build:host"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
